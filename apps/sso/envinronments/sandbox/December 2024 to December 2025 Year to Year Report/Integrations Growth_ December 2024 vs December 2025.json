            "type": "grafana-postgresql-datasource",
            "uid": "P24BB1063C80D1A5B"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "\r\nSELECT\r\n  NOW() AS time,\r\n  -- Totals at each cutoff\r\n  (SELECT COUNT(*)::int\r\n     FROM requests\r\n    WHERE archived = FALSE\r\n      AND created_at <= '2024-12-31') AS integrations_December_2024,\r\n  (SELECT COUNT(*)::int\r\n     FROM requests\r\n    WHERE archived = FALSE\r\n      AND created_at <= '2025-12-31') AS Integrations_December_2025,\r\n  -- Absolute increase\r\n  (\r\n    (SELECT COUNT(*)::int FROM requests WHERE archived = FALSE AND created_at <= '2025-12-31')\r\n    -\r\n    (SELECT COUNT(*)::int FROM requests WHERE archived = FALSE AND created_at <= '2024-12-31')\r\n  ) AS Increase,\r\n  -- Percent growth\r\n  CASE\r\n    WHEN (SELECT COUNT(*)::int FROM requests WHERE archived = FALSE AND created_at <= '2024-12-31') > 0\r\n    THEN (\r\n      (\r\n        (SELECT COUNT(*)::numeric FROM requests WHERE archived = FALSE AND created_at <= '2025-12-31')\r\n        -\r\n        (SELECT COUNT(*)::numeric FROM requests WHERE archived = FALSE AND created_at <= '2024-12-31')\r\n      )\r\n      /\r\n      (SELECT COUNT(*)::numeric FROM requests WHERE archived = FALSE AND created_at <= '2024-12-31')\r\n    ) * 100\r\n    ELSE NULL\r\n  END AS Growth_Percent;\r\n\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
