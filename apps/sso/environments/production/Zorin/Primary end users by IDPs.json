            "uid": "P24BB1063C80D1A5B"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "WITH per_request AS (\n    SELECT\n        request_id,\n        MIN(created_at) FILTER (\n            WHERE details -> 'changes' @> '[{\n  \"item\": {\n    \"rhs\": \"bceidbasic\",\n    \"kind\": \"N\"\n  },\n  \"kind\": \"A\",\n  \"path\": [\"devIdps\"]\n}]'\n        ) AS created_at,\n        MAX(created_at) FILTER (\n            WHERE details::text ILIKE '%bceidApproved%'\n        ) AS approved_at\n    FROM events\n    GROUP BY request_id\n)\nSELECT\n    ROUND(\n        AVG(EXTRACT(EPOCH FROM (approved_at - created_at))) / 86400,\n        2\n    ) AS avg_time_days\nFROM per_request\nWHERE created_at IS NOT NULL\n  AND approved_at IS NOT NULL\n  AND approved_at > created_at;",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Average days for BCeID Basic approval",
      "type": "stat"
