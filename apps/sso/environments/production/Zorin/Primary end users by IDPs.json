          "rawQuery": true,
          "rawSql": "SELECT\naud AS audience,\nCOUNT(*) AS row_count\nFROM requests\nCROSS JOIN LATERAL unnest(primary_end_users) AS aud\nWHERE dev_idps @> ARRAY[$idps]::varchar[]\nAND status = 'applied' AND archived = false\nGROUP BY aud\nUNION ALL\nSELECT\n'null' AS audience,\nCOUNT(*) AS row_count\nFROM requests\nWHERE dev_idps @> ARRAY[$idps]::varchar[]\nAND status = 'applied' AND archived = false\nAND (primary_end_users is NULL OR primary_end_users = '{}'::text[]);",
