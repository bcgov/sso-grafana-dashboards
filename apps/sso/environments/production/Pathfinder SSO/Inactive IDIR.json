                      "editorMode": "code",
                      "format": "table",
                      "rawQuery": true,
                      "rawSql": "select to_char(timestamp, 'YYYY-MM-DD') as date_deleted,  count (*)\r\nfrom ${users_table} \r\nWHERE realm = CASE '$users_table'\r\n  WHEN 'kc_deleted_idir_users' THEN 'idir'\r\n  ELSE 'azureidir'\r\nEND\r\nAND $__timeFilter(timestamp)\r\nGROUP BY to_char(timestamp, 'YYYY-MM-DD') \r\norder by to_char(timestamp, 'YYYY-MM-DD') DESC",
                      "sql": {
