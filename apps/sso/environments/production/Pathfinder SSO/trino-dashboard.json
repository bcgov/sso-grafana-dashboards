  },
  "spec": {
    "annotations": [
      {
        "kind": "AnnotationQuery",
        "spec": {
          "builtIn": true,
          "enable": true,
          "hide": true,
          "iconColor": "rgba(0, 211, 255, 1)",
          "name": "Annotations \u0026 Alerts",
          "query": {
            "datasource": {
              "name": "-- Grafana --"
            },
            "group": "grafana",
            "kind": "DataQuery",
            "spec": {},
            "version": "v0"
          }
        }
      }
    ],
    "cursorSync": "Off",
    "description": "example for querying the trino datasource",
    "editable": true,
    "elements": {
      "panel-1": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [
                {
                  "kind": "PanelQuery",
                  "spec": {
                    "hidden": false,
                    "query": {
                      "datasource": {
                        "name": "P3CB0B6E112107F8F"
                      },
                      "group": "trino-datasource",
                      "kind": "DataQuery",
                      "spec": {
                        "format": 1,
                        "rawSQL": "SELECT json_extract_scalar(message, '$.message') AS log_line\nFROM logbeast.db.freshmeat -- Use logbeast.db.hive for older data. Freshmeat has the last week only\nWHERE ELEMENT_AT(container.labels, 'namespace') = 'eb75ad-dev'\n  AND container.name = 'sso-keycloak'\n  AND message LIKE '%realmId=standard,%'\n  AND message LIKE '%clientId=css-app-in-gold-4128,%' ESCAPE '\\'\n  AND $__timeFilter(timestamp)\nORDER BY timestamp DESC"
                      },
                      "version": "v0"
                    },
                    "refId": "A"
                  }
                }
              ],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 1,
          "links": [],
          "title": "New panel",
          "vizConfig": {
            "group": "table",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {
                  "custom": {
                    "align": "auto",
                    "cellOptions": {
                      "type": "auto"
                    },
                    "footer": {
                      "reducers": []
                    },
                    "inspect": false
                  },
                  "thresholds": {
                    "mode": "absolute",
                    "steps": [
                      {
                        "color": "green",
                        "value": 0
                      },
                      {
                        "color": "red",
                        "value": 80
                      }
                    ]
                  }
                },
                "overrides": []
              },
              "options": {
                "cellHeight": "sm",
                "showHeader": true
              }
            },
            "version": "13.0.1"
          }
        }
      },
      "panel-2": {
        "kind": "Panel",
        "spec": {
          "data": {
            "kind": "QueryGroup",
            "spec": {
              "queries": [],
              "queryOptions": {},
              "transformations": []
            }
          },
          "description": "",
          "id": 2,
          "links": [],
          "title": "Description",
          "vizConfig": {
            "group": "text",
            "kind": "VizConfig",
            "spec": {
              "fieldConfig": {
                "defaults": {},
                "overrides": []
              },
              "options": {
                "code": {
                  "language": "plaintext",
                  "showLineNumbers": false,
                  "showMiniMap": false
                },
                "content": "# Trino\n\nSee the below query for the syntax on querying the TRINO datasource. Note that there are two schemas, logbeast.db.hive and logbeast.db.freshmeat. Freshmeat is live, and has data for the last 7 days. Hive does not have live data, but cuts over frequently and goes back long term.",
                "mode": "markdown"
              }
            },
            "version": "13.0.1"
          }
        }
      }
