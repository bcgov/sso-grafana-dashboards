        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P8BC80798FB985F6E"
          },
          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "with most_recent_sessions as (\r\n  -- Colected every hour\r\n  select * from client_sessions where date > now() - interval '60 minute'\r\n)\r\nSELECT\r\n    distinct realm_id as name, 1 as agg_field\r\nFROM most_recent_sessions \r\nWHERE (realm_id not in (${excludedRealms}) or realm_id = 'standard')\r\nAND environment = '${env}'",
          "refId": "B",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Realms with no sessions",
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "name",
            "mode": "outer"
          }
        },
        {
          "id": "filterByValue",
          "options": {
            "filters": [
              {
                "config": {
                  "id": "isNull",
                  "options": {}
                },
                "fieldName": "agg_field"
              }
            ],
            "match": "any",
            "type": "include"
          }
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "names": [
                "name"
              ]
            }
          }
        }
      ],
      "type": "table"
    },
