        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "${ds}"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with clients_with_service_accounts as (\r\n  SELECT\r\n      realm_id,\r\n      count(*) AS \"count\"\r\n    FROM\r\n      client\r\n    WHERE realm_id not in (${excludedRealms})\r\n    AND service_accounts_enabled = TRUE\r\n    GROUP BY realm_id\r\n)\r\nSELECT\r\n  realm_id, count as \"Clients with Service Accounts\"\r\nFROM clients_with_service_accounts\r\nGROUP BY realm_id, count\r\nORDER BY count desc;",
          "refId": "A",
          "sql": {
            "columns": [
