        "showHeader": true,
        "sortBy": [
          {
            "desc": true,
            "displayName": "Regular Sessions"
          }
        ]
      },
      "pluginVersion": "11.6.1",
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "P8BC80798FB985F6E"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with most_recent_sessions as (\r\n  -- Colected every hour\r\n  select * from client_sessions where date > now() - interval '60 minute'\r\n)\r\nSELECT\r\n    realm_id,\r\n    sum(active_sessions) as \"Regular Sessions\",\r\n    sum(offline_sessions) as \"Offline Sessions\"\r\nFROM most_recent_sessions \r\nWHERE (realm_id not in (${excludedRealms}) or realm_id = 'standard')\r\nAND environment = '${env}'\r\nGROUP BY realm_id\r\nORDER BY \"Regular Sessions\" DESC;\r\n",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "Sessions By Realm",
      "type": "table"
    },
