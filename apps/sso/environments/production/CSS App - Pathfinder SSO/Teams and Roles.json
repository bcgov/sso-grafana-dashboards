          "rawQuery": true,
          "rawSql": "select r.team_id, r.id, count(1) as role_count from requests r left join request_roles rr on r.id = rr.request_id where rr.environment = 'prod' and team_id is not null and status = 'applied' and archived is false\ngroup by r.team_id, r.id\norder by team_id asc;",
