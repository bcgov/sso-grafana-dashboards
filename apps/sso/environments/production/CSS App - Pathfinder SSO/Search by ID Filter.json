          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with duplicated_roles as (\r\n  select name, environment from request_roles group by name, environment having count(name) > 1 and count(environment) > 1\r\n), potentially_impacted_requests as (\r\n select distinct request_id, duplicated_roles.name as role_name, duplicated_roles.environment as role_env from request_roles join duplicated_roles on request_roles.name = duplicated_roles.name and request_roles.environment = duplicated_roles.environment\r\n) \r\nselect client_id, potentially_impacted_requests.role_name, role_env from requests join potentially_impacted_requests on requests.id = potentially_impacted_requests.request_id where archived=false order by role_name;\r\n-- select * from potentially_impacted_request_ids",
          "refId": "A",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          }
        }
      ],
      "title": "(RESOLVED) - Potentially Impacted Roles",
      "type": "table"
