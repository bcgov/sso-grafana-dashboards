          "rawSql": "select project_name as \"Project\", array_to_string(dev_idps, ', ') as \"Identity Providers\", array_to_string(prod_valid_redirect_uris, ', ') as \"Production URIs\", idir_user_display_name, idir_email, bceid_approved as \"Production Approved\"\r\nfrom requests\r\njoin users on users.id = requests.user_id\r\nwhere archived = false\r\nand auth_type in ('browser-login', 'both')\r\nand status != 'draft'\r\nand \r\n('bceidbasic' = any(dev_idps) or 'bceidboth' = any(dev_idps) or 'bceidbusiness' = any(dev_idps))\r\nand 'prod' = any(environments);",
