          "format": "table",
          "rawQuery": true,
          "rawSql": "select r.id as \"ID\", r.project_name as \"Project\", r.created_at as \"Created Date\", r.updated_at as \"Last Updated Date\", r.dev_idps as \"Identity Providers\", r.protocol as \"Protocol\", e.idir_user_display_name as \"Approved By\" from requests r right join events e on r.id = e.request_id where r.archived = false and 'prod' = ANY(r.environments) \nand e.event_code = 'request-update-success'\nand bceid_approved = true\nand EXISTS (\n    SELECT 1\n    FROM jsonb_array_elements(e.details->'changes') AS change\n    WHERE change->'path' @> '[\"bcServicesCardApproved\"]' and\n    change->'rhs' @> 'true'\n)\nand exists(\n  select 1 from unnest(dev_idps) as idp where idp like 'bcservicescard'\n) \norder by r.id desc;",
