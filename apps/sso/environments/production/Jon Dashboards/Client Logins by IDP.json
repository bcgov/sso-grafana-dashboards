          "editorMode": "code",
          "format": "table",
          "hide": false,
          "rawQuery": true,
          "rawSql": "select case when name is not null and name != '' then name else client_id end as name, client_id from client where realm_id = 'standard' and name not ilike '${%';",
          "refId": "B",
          "sql": {
            "columns": [
              {
                "parameters": [],
                "type": "function"
              }
            ],
            "groupBy": [
              {
                "property": {
                  "type": "string"
                },
                "type": "groupBy"
              }
            ],
            "limit": 50
          },
          "table": "client"
        },
        {
          "datasource": {
            "type": "loki",
            "uid": "P7C95B51EE4B7B0D2"
          },
          "editorMode": "code",
          "expr": "topk(10, sum(count_over_time(\r\n  {environment=\"${env}\"}\r\n  |~ \"username=[^\\\\s]+@${idp}\" \r\n  |= `realmId=standard` \r\n  |= `type=LOGIN`\r\n  != `type=LOGIN_ERROR`\r\n  | regexp \".*clientId=(?P<client_id>[^, ]+)\" [$__range]\r\n)) by (client_id))",
          "hide": false,
          "queryType": "instant",
          "refId": "A"
        }
      ],
      "title": "Top User Logins for IDP (Standard Realm)",
