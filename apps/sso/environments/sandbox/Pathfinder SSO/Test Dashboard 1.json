          "rawSql": "SELECT \r\n-- identity_provider_config.identity_provider_id, \r\nidentity_provider.realm_id,\r\n-- identity_provider.provider_alias, \r\nCOUNT(federated_identity.user_id) \r\n-- federated_identity.federated_user_id, \r\n-- federated_identity.federated_username,\r\n-- federated_identity.identity_provider\r\n-- -- identity_provider.realm_id AS realm_id, COUNT(identity_provider_id) as number_dc_users_in_realm\r\nFROM identity_provider_config \r\nINNER JOIN identity_provider ON (identity_provider_config.identity_provider_id = identity_provider.internal_id)\r\nINNER JOIN federated_identity ON (identity_provider.realm_id = federated_identity.realm_id)\r\nWHERE identity_provider_config.name LIKE '%authorizationUrl%' \r\nAND identity_provider_config.value LIKE '%vc-authn-oidc%' \r\nAND federated_identity.identity_provider = identity_provider.provider_alias \r\n-- AND identity_provider.realm_id not in ('digitalcredential', 'standard')\r\nGROUP BY identity_provider.realm_id\r\norder BY COUNT(federated_identity.user_id)\r\nLIMIT 50 ",
          "refId": "A",
