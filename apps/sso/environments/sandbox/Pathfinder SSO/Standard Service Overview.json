          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "SELECT\r\n count( distinct   \"public\".\"client\".\"client_id\") AS \"client_id\"  ,\r\n  \"Client Scope\".\"name\" AS \"Client Scope__name\"\r\n\r\nFROM\r\n  \"public\".\"client\"\r\n \r\nLEFT JOIN \"public\".\"client_scope_client\" AS \"Client Scope Client\" ON \"public\".\"client\".\"id\" = \"Client Scope Client\".\"client_id\"\r\n  LEFT JOIN \"public\".\"client_scope\" AS \"Client Scope\" ON \"Client Scope Client\".\"scope_id\" = \"Client Scope\".\"id\"\r\n  LEFT JOIN \"public\".\"keycloak_role\" AS \"Keycloak Role\" ON \"public\".\"client\".\"id\" = \"Keycloak Role\".\"client\"\r\n  LEFT JOIN \"public\".\"user_role_mapping\" AS \"User Role Mapping\" ON \"Keycloak Role\".\"id\" = \"User Role Mapping\".\"role_id\"\r\n  LEFT JOIN \"public\".\"user_attribute\" AS \"User Attribute - User\" ON \"User Role Mapping\".\"user_id\" = \"User Attribute - User\".\"user_id\"\r\nWHERE\r\n  (\r\n    \"public\".\"client\".\"description\" = 'CSS App Created' OR \"public\".\"client\".\"description\" = 'Manually Created to Test BCSC SIT'\r\n  )\r\n  AND (  \"public\".\"client\".\"realm_id\" = 'standard')\r\n \r\n  AND (\r\n\r\n(\"Client Scope\".\"name\" = 'bceidbasic')\r\n    OR (\"Client Scope\".\"name\" = 'bceidbasic-saml')\r\n    OR (\"Client Scope\".\"name\" = 'bceidboth')\r\n    OR (\"Client Scope\".\"name\" = 'bceidboth-saml')\r\n    OR (\"Client Scope\".\"name\" = 'bceidbusiness')\r\n    OR (\"Client Scope\".\"name\" = 'bceidbusiness-saml')\r\nOR  (\"Client Scope\".\"name\" = 'azureidir')  \r\n OR (\"Client Scope\".\"name\" = 'azureidir-saml')    \r\n OR (\"Client Scope\".\"name\" = 'githubbcgov')\r\nOR (\"Client Scope\".\"name\" = 'githubbcgov-saml')\r\n OR (\"Client Scope\".\"name\" = 'githubpublic')\r\n OR (\"Client Scope\".\"name\" = 'githubpublic-saml')\r\nOR (\"Client Scope\".\"name\" = 'idir')\r\nOR (\"Client Scope\".\"name\" = 'idir-saml') \r\nOR (\"Client Scope\".\"name\" LIKE 'bcsc%') \r\n  )\r\n\r\n  -- AND (\r\n  --    \"User Role Mapping\".\"user_id\" IS NOT NULL\r\n  -- )\r\n\r\n  group by   \"Client Scope\".\"name\" \r\n\r\n  order by   \"Client Scope\".\"name\" ",
          "refId": "A",
