                        "rawQuery": true,
                        "rawSql": "SELECT\n    string_agg(realm, ', ') AS realms,\n    string_agg(email, '; ') AS emails\nFROM (\n    SELECT\n        realm,\n        unnest(array[\n            CASE WHEN $product_owners THEN NULLIF(TRIM(product_owner_email), '') END,\n            CASE WHEN $technical_contacts THEN NULLIF(TRIM(technical_contact_email), '') END,\n            CASE WHEN $second_technical_contacts THEN NULLIF(TRIM(second_technical_contact_email), '') END\n        ]) AS email\n    FROM rosters\n    WHERE realm in ($realms ) and archived = $archived\n) t\nWHERE email IS NOT NULL;",
